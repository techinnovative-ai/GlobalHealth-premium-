# Copy to .env (never commit real secrets). Read by the backend; the frontend only needs BACKEND_URL.

# --- core -------------------------------------------------------------
SENTIN_ENV=development            # development | production
# Required in production (>= 32 chars). Development generates and stores one under backend/data/.
JWT_SECRET=
DATABASE_URL=sqlite:///./data/sentin.db   # or postgresql+psycopg://user:pass@host:5432/sentin

# --- bootstrap admin (created once, when the users table is empty) -----
ADMIN_EMAIL=admin@sentin-ai.dev
ADMIN_PASSWORD=                   # if empty, a random password is written to backend/data/initial_admin_password.txt

# --- security -----------------------------------------------------------
COOKIE_SECURE=false               # true behind HTTPS (default true in production)
CORS_ORIGINS=http://localhost:3000
ALLOW_PRIVATE_TARGETS=true        # false in production: blocks private/loopback target addresses
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# --- evaluation engine -----------------------------------------------
WORKER_EMBEDDED=true              # false when running `python -m app.worker` as a separate process
WORKER_CONCURRENCY=2
EVAL_STEP_DELAY_MS=350            # pause between checkpoints so the live view is readable (0 in production)
HTTP_TIMEOUT_SECONDS=6
MAX_RESPONSE_BYTES=65536

# --- demo ----------------------------------------------------------------
ENABLE_DEMO_TARGETS=true          # mounts /demo/* intentionally vulnerable targets
SEED_DEMO_DATA=true
PUBLIC_API_BASE=http://127.0.0.1:8000   # base URL the demo targets are registered with

# --- frontend (Next.js server) ---------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
